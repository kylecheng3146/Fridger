-- SQLDelight schema file
-- Add your table definitions here

CREATE TABLE Ingredient (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    addDate TEXT NOT NULL,
    expirationDate TEXT NOT NULL,
    syncId TEXT NOT NULL DEFAULT '',
    ownerId TEXT,
    categoryOverride TEXT,
    syncState TEXT NOT NULL DEFAULT 'PENDING',
    isDeleted INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE ShoppingListItem (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    quantity TEXT,
    isChecked INTEGER NOT NULL DEFAULT 0,
    category TEXT
);

CREATE TABLE SavedRecipe (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    ingredients TEXT NOT NULL,
    instructions TEXT NOT NULL,
    cookingTime TEXT NOT NULL,
    difficulty TEXT NOT NULL,
    servings INTEGER NOT NULL,
    savedAt INTEGER NOT NULL
);

-- Queries for SavedRecipe
selectAllSavedRecipes:
SELECT * FROM SavedRecipe ORDER BY savedAt DESC;

insertSavedRecipe:
INSERT OR REPLACE INTO SavedRecipe(id, title, description, ingredients, instructions, cookingTime, difficulty, servings, savedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteSavedRecipeById:
DELETE FROM SavedRecipe WHERE id = ?;

-- Queries for Ingredient
selectAllIngredients:
SELECT * FROM Ingredient WHERE isDeleted = 0;

selectIngredientsByOwner:
SELECT * FROM Ingredient WHERE ownerId IS ? AND isDeleted = 0 ORDER BY id;

selectPendingInventoryItems:
SELECT * FROM Ingredient WHERE ownerId IS ? AND syncState = 'PENDING' ORDER BY id;

selectSyncedInventoryItems:
SELECT * FROM Ingredient WHERE ownerId IS ? AND syncState = 'SYNCED' AND isDeleted = 0;

selectIngredientsWithoutSyncId:
SELECT id FROM Ingredient WHERE syncId = '';

getIngredientById:
SELECT * FROM Ingredient
WHERE id = ? AND isDeleted = 0;

insertIngredient:
INSERT INTO Ingredient(name, addDate, expirationDate, ownerId, syncId)
VALUES (?, ?, ?, ?, ?);

updateIngredientSyncId:
UPDATE Ingredient SET syncId = ? WHERE id = ? AND syncId = '';

claimAnonymousIngredients:
UPDATE Ingredient SET ownerId = ?, syncState = 'PENDING' WHERE ownerId IS NULL AND isDeleted = 0;

updateIngredientCategory:
UPDATE Ingredient SET categoryOverride = ?, syncState = 'PENDING' WHERE id = ? AND ownerId IS ? AND isDeleted = 0;

markIngredientSynced:
UPDATE Ingredient SET syncState = 'SYNCED' WHERE syncId = ? AND ownerId IS ?
AND name = ? AND addDate = ? AND expirationDate = ? AND categoryOverride IS ? AND isDeleted = 0;

markIngredientDeleted:
UPDATE Ingredient SET isDeleted = 1, syncState = 'PENDING' WHERE id = ? AND ownerId IS ?;

deleteIngredientBySyncId:
DELETE FROM Ingredient WHERE syncId = ? AND ownerId IS ?;

selectIngredientBySyncId:
SELECT * FROM Ingredient WHERE syncId = ? AND ownerId IS ?;

insertRemoteIngredient:
INSERT INTO Ingredient(name, addDate, expirationDate, syncId, ownerId, categoryOverride, syncState, isDeleted)
VALUES (?, ?, ?, ?, ?, ?, 'SYNCED', 0);

updateRemoteIngredient:
UPDATE Ingredient SET name = ?, addDate = ?, expirationDate = ?, categoryOverride = ?, syncState = 'SYNCED', isDeleted = 0
WHERE syncId = ? AND ownerId IS ? AND syncState = 'SYNCED' AND isDeleted = 0;

deleteIngredientById:
DELETE FROM Ingredient
WHERE id = ? AND ownerId IS ?;

-- Queries for ShoppingListItem
selectAllShoppingItems:
SELECT * FROM ShoppingListItem ORDER BY isChecked ASC, id DESC;

-- Items by category (used as listId)
selectShoppingItemsByCategory:
SELECT * FROM ShoppingListItem WHERE category = ? ORDER BY isChecked ASC, id DESC;

insertShoppingItem:
INSERT INTO ShoppingListItem(name, quantity, isChecked, category)
VALUES (?, ?, ?, ?);

selectLastShoppingItemIdByCategory:
SELECT id FROM ShoppingListItem WHERE category = ? ORDER BY id DESC LIMIT 1;

updateShoppingItemChecked:
UPDATE ShoppingListItem SET isChecked = ? WHERE id = ?;

deleteShoppingItemById:
DELETE FROM ShoppingListItem WHERE id = ?;

clearPurchasedItems:
DELETE FROM ShoppingListItem WHERE isChecked = 1;

clearPurchasedItemsByCategory:
DELETE FROM ShoppingListItem WHERE isChecked = 1 AND category = ?;

-- Delete all items by category (used when deleting a list)
deleteShoppingItemsByCategory:
DELETE FROM ShoppingListItem WHERE category = ?;
